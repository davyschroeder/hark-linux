#!/bin/sh
# Runs once per user at first login (XDG autostart).
. /usr/lib/hark/i18n.sh
MARK="$HOME/.config/hark-first-login-done"
hark-menu-labels   # (re)write jgmenu entries in the session language
[ -e "$MARK" ] && exit 0
mkdir -p "$HOME/.config" && touch "$MARK"

DESK="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
mkdir -p "$DESK"
for f in hark-tools hark-welcome; do
  cp "/usr/share/applications/$f.desktop" "$DESK/" && chmod +x "$DESK/$f.desktop"
done
ln -sfn "$HOME/hark-examples" "$DESK/hark-examples" 2>/dev/null || true

exec terminator -T "Hark Linux" --geometry 900x880 -x hark-welcome --wait
