#!/bin/bash
# hark-welcome — cheat sheet for new NURDspace visitors (English / Nederlands)
#   --wait   wait for Enter (for use in its own terminal window)
. /usr/lib/hark/i18n.sh
G=$'\e[1;32m'; Y=$'\e[1;33m'; C=$'\e[1;36m'; N=$'\e[0m'

cat <<EOF
${G}
  _   _            _      _      _
 | | | | __ _ _ __| | __ | |    (_)_ __  _   ___  __
 | |_| |/ _\` | '__| |/ / | |    | | '_ \\| | | \\ \\/ /
 |  _  | (_| | |  |   <  | |___ | | | | | |_| |>  <
 |_| |_|\\__,_|_|  |_|\\_\\ |_____||_|_| |_|\\__,_/_/\\_\\
${N}
 $(head -n1 /etc/hark-release 2>/dev/null)  -  $(_t "the NURDspace distro" "de distro van NURDspace")
 $(_t "Live user" "Live-gebruiker"): ${Y}nurd${N} ($(_t "no password; sudo works right away" "geen wachtwoord; sudo werkt direct"))

${C}$(_t "Hark button      " "Hark-knop        ")${N}    $(_t "bottom left, or the Super key / Alt+F1  (Hark!)" "linksonder, of de Super-toets / Alt+F1  (Hark!)")
${C}$(_t "Toolbox          " "Gereedschap      ")${N}    hark-tools
${C}$(_t "Language/keyboard" "Taal/toetsenbord ")${N}    hark-language
${C}$(_t "LDAP login       " "Inloggen via LDAP")${N}    sudo hark-ldap

${C}Arduino / ESP32${N}
  arduino-cli          arduino-cli board list
  PlatformIO           pio project init -b esp32dev
  esptool              esptool --port /dev/ttyUSB0 chip_id
  Thonny / mpremote    MicroPython $(_t "on" "op") ESP32 / Pi Pico
  $(_t "Serial " "Serieel")              picocom -b 115200 /dev/ttyUSB0   ($(_t "quit" "uit"): Ctrl+A Ctrl+X)

${C}Raspberry Pi / Sense HAT${N}
  sense_emu_gui        $(_t "emulator;  sense-python script.py  runs a script" "emulator;  sense-python script.py  draait een script")

${C}$(_t "Drawing            " "Tekenen            ")${N}  GIMP, Inkscape, Krita, MyPaint
${C}CAD / PCB / 3D     ${N}  FreeCAD, LibreCAD, OpenSCAD, SolveSpace, KiCad, PrusaSlicer
${C}Benchmarks         ${N}  hardinfo, sysbench, hdparm, glmark2, inxi
${C}$(_t "Monitor calibration" "Monitor kalibreren ")${N}  DisplayCAL
${C}$(_t "Emulation          " "Emulatie           ")${N}  WINE, DOSBox, VICE (C64), PICO-8 via hark-tools
${C}Eyecandy           ${N}  cmatrix, hollywood
${C}$(_t "Network            " "Netwerk            ")${N}  nmap, Wireshark, iperf3, mtr   ($(_t "only with permission!" "alleen met toestemming!"))

${C}$(_t "Install" "Installeren")${N}  $(_t '"Install Hark Linux" icon on the desktop (or "Graphical install" in the boot menu)' 'icoon "Hark Linux installeren" op het bureaublad (of "Graphical install" in het opstartmenu)')
$(_t "Examples" "Voorbeelden"): ~/hark-examples
EOF

[ "$1" = "--wait" ] && read -rp "$(_t 'Press Enter to close...' 'Druk op Enter om te sluiten...')" _
exit 0
